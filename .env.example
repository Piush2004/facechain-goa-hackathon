# ---- Reverse-image search (required) --------------------------------------
# Get a key at https://serpapi.com/  (free tier: ~100 searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Default face-scan image used when you run pipeline.py with no --image/--image-url.
# Must be a publicly reachable URL so Google Lens can fetch it.
SOURCE_IMAGE_URL=

# ---- Blockchain backend --------------------------------------------------
# local = in-process EVM (eth-tester), no node/funds/network needed (default)
# rpc   = a real EVM chain over JSON-RPC (needs RPC_URL + PRIVATE_KEY below)
CHAIN=local

# Only used when CHAIN=rpc. Example: Polygon Amoy or Ethereum Sepolia testnet.
# RPC_URL=https://rpc-amoy.polygon.technology
# RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# PRIVATE_KEY=0xabc...   # a TEST wallet only. never a real-funds key.
